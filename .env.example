# OpenAI-compatible endpoint of Qwen on the m1max (tailnet)
M1MAX_URL=http://100.67.98.112:8080/v1
# The m1max's own API key (secret; set it only in .env)
M1MAX_API_KEY=
# Model id as listed by GET /models on the m1max
M1MAX_MODEL=
# MCP-Searxng streamable HTTP endpoint
MCP_URL=http://12.0.0.225:3000/mcp
# Folder that holds the research task folders
RESEARCH_DIR=./research
# Max tokens per model request (clamped to 32000-64000)
CONTEXT_BUDGET=48000
# Sources the executor aims to save before it stops
MIN_SOURCES=8
# Hard cap on saved sources per research task
MAX_SOURCES=15
# GUI bind address (0.0.0.0 = LAN and tailnet)
GUI_HOST=0.0.0.0
# GUI port
GUI_PORT=8090
